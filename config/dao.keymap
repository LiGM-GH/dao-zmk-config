#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        // zmk,matrix_transform = &extra_keys_transform;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp RIGHT_BRACKET  &kp Q  &kp W           &kp E        &kp R            &kp T        &kp Y        &kp U            &kp I        &kp O            &kp P     &kp LEFT_BRACKET
&kp GRAVE          &kp A  &mt LEFT_ALT S  &mt LCTRL D  &mt LEFT_GUI F   &kp G        &kp H        &mt RIGHT_GUI J  &mt RCTRL K  &mt RIGHT_ALT L  &kp SEMI  &kp SQT
&kp MINUS          &kp Z  &kp X           &kp C        &kp V            &kp B        &kp N        &kp M            &kp COMMA    &kp DOT          &kp FSLH  &kp BACKSLASH
                                          &lt RSE TAB  &mt LSHFT SPACE  &lt LWR RET  &lt LWR ESC  &mt RSHFT BSPC   &lt RSE DEL
            >;
        };

        lower_layer {
            bindings = <
&kp F1     &kp F2           &kp F3                 &kp F4              &kp F5             &kp F6        &kp F7        &kp F8             &kp F9        &kp F10                 &kp F11                &kp F12
&kp PLUS   &kp NUMBER_1     &mt LEFT_ALT NUMBER_2  &mt LCTRL NUMBER_3  &mt LGUI NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &mt RGUI NUMBER_7  &mt RCTRL N8  &mt RIGHT_ALT NUMBER_9  &kp NUMBER_0           &none
&kp EQUAL  &kp EXCLAMATION  &kp AT                 &kp HASH            &kp DOLLAR         &kp PERCENT   &kp CARET     &kp AMPERSAND      &kp ASTERISK  &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &none
                                                   &lt ADJ TAB         &trans             &trans        &trans        &trans             &lt ADJ DEL
            >;
        };

        raise_layer {
            bindings = <
&none  &none  &none              &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none          &kp PAUSE_BREAK  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp C_MUTE           &kp SLCK         &kp CAPSLOCK
&none  &none  &mt LEFT_ALT LEFT  &mt LCTRL UP          &mt LGUI DOWN         &kp RIGHT      &kp LEFT         &mt RGUI DOWN    &mt RCTRL UP       &mt RIGHT_ALT RIGHT  &kp INS          &kp K_APP
&none  &none  &kp PAGE_UP        &kp HOME              &kp END               &kp PAGE_DOWN  &kp PAGE_DOWN    &kp END          &kp HOME           &kp PAGE_UP          &kp PRINTSCREEN  &none
                                 &trans                &trans                &lt ADJ RET    &lt ADJ ESC      &trans           &trans
            >;
        };

        adjust_layer {
            bindings = <
&bootloader  &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &bootloader
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
&sys_reset   &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &sys_reset
                                         &trans        &none         &trans        &trans        &none         &trans
            >;
        };
    };
};
